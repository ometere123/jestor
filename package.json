{
  "name": "jestor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:frontend:unit": "vitest run tests/frontend --environment node",
    "test:direct": "python -m pytest tests/direct -q",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env JESTOR_E2E_LIVE=true playwright test tests/e2e/live.spec.ts",
    "test:frontend": "npm run test:frontend:unit && npm run lint && npx tsc --noEmit --pretty false && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "genlayer-js": "^1.1.8",
    "lucide-react": "^1.18.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "viem": "2.57.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "genlayer": "0.39.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
